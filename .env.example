# TwinStack Environment Variables
# Copy this file to .env and fill in the values.

# Required: Google Gemini API key for AI request structuring
GEMINI_API_KEY=

# Required in production: Secret for signing session cookies (use a random 64+ char string)
SESSION_SECRET=

# Set to 'production' for Railway deployment
NODE_ENV=development

# Railway injects these automatically — do not set manually:
# PORT=3000
# RAILWAY_VOLUME_MOUNT_PATH=/data

# ----------------------------------------------------------------
# PASSWORDS: Managed exclusively in the database (bcrypt hashed).
# On first startup, random credentials are printed to the console.
# Use Settings > Change Password in the app to update them.
# No password environment variables are needed.
# ----------------------------------------------------------------
