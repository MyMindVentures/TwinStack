# TwinStack Environment Variables
# Copy this file to .env and fill in the values.

# Required: Google Gemini API key for AI request structuring
GEMINI_API_KEY=

# Required in production: Secret for signing session cookies (use a random 64+ char string)
SESSION_SECRET=

# Optional: Override seeded user passwords (strongly recommended in production)
ARCHITECT_PASSWORD=
BUILDER_PASSWORD=
SUBSCRIBER_PASSWORD=

# Set to 'production' for Railway deployment
NODE_ENV=development

# Railway injects these automatically — do not set manually:
# PORT=3000
# RAILWAY_VOLUME_MOUNT_PATH=/data
